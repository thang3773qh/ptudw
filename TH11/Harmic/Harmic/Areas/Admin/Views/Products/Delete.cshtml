@model Harmic.Models.TbProduct

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xóa sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">General Form</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Xóa sản phẩm</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-2">
                            Tiêu đề
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Title)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Alias)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Alias)
                        </dd>
                        <dt class="col-sm-2">
                            Mô tả
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Description)
                        </dd>
                        <dt class="col-sm-2">
                            Chi tiết
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Detail)
                        </dd>
                        <dt class="col-sm-2">
                            Ảnh
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Image)
                        </dd>
                        <dt class="col-sm-2">
                            Giá
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Price)
                        </dd>
                        <dt class="col-sm-2">
                            Giá giảm
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.PriceSale)
                        </dd>
                        <dt class="col-sm-2">
                            Số lượng
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Quantity)
                        </dd>
                        <dt class="col-sm-2">
                            Ngày tạo
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.CreatedDate)
                        </dd>
                        <dt class="col-sm-2">
                            Tạo bởi
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.CreatedBy)
                        </dd>
                        <dt class="col-sm-2">
                            Ngày sửa
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ModifiedDate)
                        </dd>
                        <dt class="col-sm-2">
                            Sửa bởi
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ModifiedBy)
                        </dd>
                        <dt class="col-sm-2">
                            Mới
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsNew)
                        </dd>
                        <dt class="col-sm-2">
                            Bán chạy
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsBestSeller)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.UnitInStock)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.UnitInStock)
                        </dd>
                        <dt class="col-sm-2">
                            Hoạt động
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.IsActive)
                        </dd>
                        <dt class="col-sm-2">
                            Sao
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Star)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.CategoryProduct)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.CategoryProduct.CategoryProductId)
                        </dd>
                    </dl>
                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ProductId" />
                        <input type="submit" value="Xóa" class="btn btn-danger" /> |
                        <a asp-action="Index">Quay lại danh sách</a>
                    </form>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>


